{
  "name": "interview-helper",
  "productName": "Interview Helper",
  "version": "1.0.0",
  "description": "Real-Time Interview Helper — Floating Overlay",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.interviewhelper.app",
    "productName": "Interview Helper",
    "directories": {
      "output": "../packaging/release"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Interview Helper"
    },
    "extraResources": [
      {
        "from": "../packaging/dist/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "settings-renderer.js",
      "index.html",
      "settings.html",
      "styles.css",
      "settings.css"
    ]
  },
  "author": "Interview Helper",
  "license": "MIT"
}
