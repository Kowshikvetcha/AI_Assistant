# AI provider ("openai" by default)
AI_PROVIDER=openai

# API key (single place; preferred)
AI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxx

# Optional: for OpenAI-compatible providers (OpenRouter, Groq, etc.)
# AI_BASE_URL=https://api.openai.com/v1

# Backward compatibility (optional if AI_API_KEY is set)
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxx

# WebSocket server port
WEBSOCKET_PORT=8765

# Audio chunk duration in seconds (1-3)
AUDIO_CHUNK_DURATION=2

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional model overrides. Leave empty to use provider defaults.
LLM_MODEL=
SUMMARY_MODEL=
STT_MODEL=

# Max tokens for LLM response
LLM_MAX_TOKENS=1024
